{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pwd)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -v)",
      "Bash(git branch --list*)",

      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:python.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git checkout --*)",
      "Bash(git restore --*)",
      "Bash(git branch -D*)",
      "Bash(git rebase -i*)",

      "Bash(kubectl * --context=prod*)",
      "Bash(kubectl * --context prod*)",
      "Bash(kubectl * --context=production*)",
      "Bash(kubectl * --context production*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(docker push*)",
      "Bash(gh workflow run*)",
      "Bash(gh release create*)",

      "Bash(psql *prod*)",
      "Bash(psql *production*)",
      "Bash(mysql *prod*)",
      "Bash(mysql *production*)",
      "Bash(mongosh *prod*)",
      "Bash(mongosh *production*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/secrets/**)",
      "Read(**/credentials)",
      "Read(**/credentials.*)"
    ]
  }
}
